# Required Stripe server-side secrets. Never expose these to the frontend.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Hosted Checkout redirect URLs (UX only; webhook determines payment success).
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# EcomGrove currently stores order totals as Vietnamese dong.
PAYMENT_CURRENCY=vnd

# Pending payments are reconciled with Stripe every 10 minutes.
